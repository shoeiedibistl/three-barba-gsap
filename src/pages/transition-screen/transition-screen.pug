extends ../../layout/layout

block variables
  -
    const pageName = 'transition-screen'
    const pageTitle = 'transition-screen'

block content
  main
    .inner
      button.my-transition-screen__start-btn(data-my-transition-screen-start='') start
      
      - for (var i = 1; i <= 48; i++)
        p.my-transition-screen__content some content

      .my-transition-screen(data-my-transition-screen='')
        - for (var i = 1; i <= 48; i++)
          .my-transition-screen__item(data-my-transition-screen-item='')
          