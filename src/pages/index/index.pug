extends ../../layout/layout

block variables
  -
    const pageTitle = 'Index'

    const pages = [
      {
        name: 'main',
        path: 'main'
      }
    ] 

block content
  main.index

    ul.index__pages
      each page in pages
        li.index__pages-item
          a(href=page.path).index__link.text-18= page.name
